# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# If left empty, a random key is generated and persisted in the config directory.
DJANGO_SECRET_KEY=
DEBUG=False
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=
USING_REVERSE_PROXY=True
CORS_ALLOW_ALL_ORIGINS=False
DATABASE_ENGINE=postgresql
DATABASE_NAME=pandachaika
DATABASE_USERNAME=panda_user
DATABASE_PASSWORD=panda_password
DATABASE_HOST=db
DATABASE_PORT=5432
# Database connection pooling & persistence options
# DATABASE_CONN_MAX_AGE=600
# DATABASE_WORKER_CONN_MAX_AGE=300
# DATABASE_CONN_HEALTH_CHECKS=true
# DATABASE_POOLING_ENABLE=false
# DATABASE_POOL_MIN_SIZE=4
# DATABASE_POOL_MAX_SIZE=10
# DATABASE_POOL_TIMEOUT=30.0
# DATABASE_POOL_MAX_LIFETIME=
# DATABASE_POOL_MAX_IDLE=600.0
PUID=1000
PGID=1000
WEBSERVER_BACKEND=gunicorn

# Background worker configuration
# - auto (default): Automatically runs workers in the viewer container (single-container mode)
#   unless a dedicated 'worker' container is detected on the network.
# - true: Always run background workers inside the viewer container (forces single-container mode).
# - false: Never run background workers inside the viewer container (e.g. pure web node).
START_WORKER=auto
# Optional arguments to pass to worker (e.g. --all-schedulers)
WORKER_ARGS=
# Set WORKER_SKIP_MIGRATIONS=true if you only want the web container to run database migrations
WORKER_SKIP_MIGRATIONS=false

# Optional Elasticsearch configuration
# Enable by running: docker compose --profile elasticsearch up
# Or uncomment COMPOSE_PROFILES=elasticsearch below to enable by default:
# COMPOSE_PROFILES=elasticsearch
# ELASTICSEARCH_ENABLE=true
# ELASTICSEARCH_URL=http://elasticsearch:9200/
